# Copy to .env for local development. NEVER commit a real .env. Values below are placeholders.
ENVIRONMENT=development                  # development | production
MONGODB_URI=mongodb://localhost:27017    # Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=financeai
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters   # python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173       # production: exact Vercel URL(s), comma separated, e.g. https://your-app.vercel.app
MAX_UPLOAD_BYTES=5242880                 # 5 MB
MAX_IMPORT_ROWS=5000
MAX_EXPORT_ROWS=50000
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Payment Slip Scanner (local Tesseract OCR; see docs/PAYMENT_SLIPS.md) ---
TESSERACT_CMD=                           # empty = auto-detect (PATH, then C:\Program Files\Tesseract-OCR on Windows)
OCR_LANG=eng
OCR_TIMEOUT_SECONDS=40
OCR_MAX_CONCURRENCY=1
SLIP_MAX_FILE_BYTES=5242880              # 5 MB per slip
SLIP_MAX_FILES_PER_BATCH=20
SLIP_MAX_PDF_PAGES=5
SLIP_BATCH_TTL_HOURS=24
SLIP_LOW_CONFIDENCE=60
