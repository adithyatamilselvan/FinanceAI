# Secrets and local configuration: never commit. Only the *.example templates (placeholders) are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
service-account*.json
credentials*.json

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node / frontend build output
node_modules/
dist/
*.tsbuildinfo
coverage/
.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Deployment tooling
.vercel
.gcloud/

# Local databases, uploads and generated artifacts (the app stores no uploads; these guard against accidents)
*.sqlite
*.sqlite3
*.db
uploads/
tmp/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
